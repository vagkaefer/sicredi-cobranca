{
    "name": "vagkaefer/sicredi-cobranca",
    "description": "Pacote Laravel para as APIs do Sicredi: Cobrança (boleto, boleto híbrido com Pix, consultas, comandos de instrução, webhook de liquidação) e Pix (cobrança imediata, experimental)",
    "type": "library",
    "keywords": [
        "sicredi",
        "boleto",
        "pix",
        "api pix",
        "cobranca imediata",
        "boleto hibrido",
        "cobranca",
        "laravel"
    ],
    "license": "MIT",
    "homepage": "https://github.com/vagkaefer/sicredi-cobranca",
    "authors": [
        {
            "name": "Vagner Kaefer",
            "email": "vagner@kaefer.eng.br"
        }
    ],
    "support": {
        "issues": "https://github.com/vagkaefer/sicredi-cobranca/issues",
        "source": "https://github.com/vagkaefer/sicredi-cobranca"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "VagKaefer\\SicrediCobranca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VagKaefer\\SicrediCobranca\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VagKaefer\\SicrediCobranca\\SicrediCobrancaServiceProvider"
            ],
            "aliases": {
                "SicrediCobranca": "VagKaefer\\SicrediCobranca\\Facades\\SicrediCobranca",
                "SicrediPix": "VagKaefer\\SicrediCobranca\\Facades\\SicrediPix"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}
